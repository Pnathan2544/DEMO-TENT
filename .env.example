# Copy to .env and fill in your values.
# The API connects as saas_app (non-superuser) so RLS is enforced.

APP_PORT=8080
APP_ENV=development

# Connects as saas_app — created by `make migrate`
DATABASE_URL=postgres://saas_app:saas_secret@localhost:5432/saas_db?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-char-secret

# Optional: required for billing features
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Used as the return URL after Stripe Billing Portal
FRONTEND_URL=http://localhost:3000
